# Copie para .env e ajuste conforme necessário. Usado pelo docker-compose.yml.

# PostgreSQL
POSTGRES_DB=thothai
POSTGRES_USER=thothai
POSTGRES_PASSWORD=thothai
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=thothai-media

# --- Configuração do backend (perfil local) ---
# Banco
DB_URL=jdbc:postgresql://localhost:5432/thothai
DB_USERNAME=thothai
DB_PASSWORD=thothai

# MinIO (visto pelo backend)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Admin único (seed) — RF01
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Sessão (RF01). Defina SESSION_COOKIE_SECURE=true ao servir atrás de HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m

# Frontend (dev local fora do Docker)
FRONTEND_ORIGIN=http://localhost:4200

# Gateway (stack Docker) — porta pública e origem do navegador
PUBLIC_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088

# Hosts autorizados pelo SSR do Angular (allowlist anti-SSRF). Defina o(s) hostname(s) públicos
# ao expor o app fora de localhost. Vírgula-separado; aceita curingas (ex.: *.seudominio.com).
NG_ALLOWED_HOSTS=localhost

# IA (RF04/RF05) — provider abstraído, default Claude
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Busca viva (RF04) — provider abstraído, default Tavily
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
