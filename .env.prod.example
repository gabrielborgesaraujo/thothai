# Produção — copie para .env e preencha TODOS os valores.
# Usado por: docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# Variáveis marcadas como obrigatórias fazem o compose abortar se ficarem em branco.

# --- PostgreSQL (obrigatório) ---
POSTGRES_DB=thothai
POSTGRES_USER=thothai
POSTGRES_PASSWORD=                 # OBRIGATÓRIO — segredo forte

# --- MinIO (obrigatório) ---
MINIO_ROOT_USER=                   # OBRIGATÓRIO
MINIO_ROOT_PASSWORD=               # OBRIGATÓRIO — segredo forte
MINIO_BUCKET=thothai-media
# Porta publicada para servir as mídias (objetos). O console (9001) não é exposto.
MINIO_PORT=9000
# URL pública das mídias, alcançável pelo navegador (CDN ou https://midia.seudominio.com).
MINIO_PUBLIC_URL=                  # OBRIGATÓRIO

# --- Admin único (RF01) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                    # OBRIGATÓRIO — segredo forte

# --- Sessão (RF01) ---
SESSION_COOKIE_SECURE=true         # true atrás de HTTPS
SESSION_TIMEOUT=30m

# --- Gateway / origem pública ---
PUBLIC_PORT=8088
PUBLIC_ORIGIN=                     # OBRIGATÓRIO — ex.: https://seudominio.com
NG_ALLOWED_HOSTS=                  # OBRIGATÓRIO — hostname(s) públicos; aceita curingas (*.seudominio.com)

# --- E-mail transacional (reset de senha) — OPCIONAL: sem SMTP, o link é apenas logado ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@seudominio.com

# --- IA / busca viva (RF04/RF05) — fallback OPCIONAL de servidor (só Anthropic/Tavily).
# O motor de IA (Anthropic, OpenAI, Gemini, Qwen ou compatível) é configurado pelo painel,
# em Integrações, e tem precedência sobre estas variáveis. ---
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
